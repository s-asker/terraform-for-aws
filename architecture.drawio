        <mxCell id="title" value="Terraform configuration • AWS eu-north-1&#10;Source diagram; deployed state not verified" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#666666;fontSize=14;verticalAlign=middle;" vertex="1" parent="1">
