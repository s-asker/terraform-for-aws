          <mxGeometry x="350" y="365" width="260" height="85" as="geometry" />
        </mxCell>
        <mxCell id="ep" value="Interface endpoints • HTTPS :443&#10;ECR API / ECR DKR&#10;Secrets Manager / Logs" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#666666;fontSize=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="720" y="360" width="330" height="100" as="geometry" />
