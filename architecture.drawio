        <mxCell id="cert" value="ACM certificate&#10;DNS validation record" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#666666;fontSize=14;verticalAlign=middle;" vertex="1" parent="1">
