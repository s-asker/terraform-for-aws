        <mxCell id="aws" value="AWS service dependencies&#10;ECR: test_app_ecr:latest&#10;Secrets: application-sm → APP_MESSAGE&#10;CloudWatch Logs: /ecs/my-web-app&#10;S3: ECR image layers" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#666666;fontSize=14;verticalAlign=middle;" vertex="1" parent="1">
