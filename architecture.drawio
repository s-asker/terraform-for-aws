        <mxCell id="tasks" value="ECS service nginx-svc • desired count 2&#10;Fargate-compatible tasks • web-container :8080&#10;No public IP • target health check /health" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#666666;fontSize=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="370" y="605" width="640" height="85" as="geometry" />
